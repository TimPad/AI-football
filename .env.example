PGUSER=aifootball
PGDATABASE=aifootball
PGPASSWORD=
# Заполните пароль локально и укажите его в DATABASE_URL, не коммитьте .env.
DATABASE_URL=postgresql+psycopg://aifootball:CHANGE_ME@127.0.0.1:54329/aifootball
ALLOWED_ORIGIN=http://127.0.0.1:8000
SECURE_COOKIES=false
ATTACHMENT_ROOT=data/service/attachments

# Включать после подключения условий Яндекса для хранения результатов в закрытом кабинете.
YANDEX_ADDRESS_ENABLED=false
YANDEX_SUGGEST_KEY=
YANDEX_GEOCODER_KEY=
# Независимый случайный секрет не короче 32 символов, одинаковый у всех процессов.
ADDRESS_SIGNING_SECRET=

# Qwen: выбранный пользователем workspace Сингапура; ключ того же региона.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1

# Письма верификации/восстановления капитана; Fernet key хранится отдельно от БД.
CAPTAIN_MAIL_KEY=
CAPTAIN_SMTP_HOST=
CAPTAIN_SMTP_PORT=587
CAPTAIN_SMTP_USER=
CAPTAIN_SMTP_PASSWORD=
CAPTAIN_MAIL_FROM=
